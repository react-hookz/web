{
	"name": "@react-hookz/web",
	"version": "24.0.4",
	"description": "React hooks done right, for browser and SSR.",
	"keywords": [
		"browser",
		"hook",
		"react",
		"react-hook",
		"ssr"
	],
	"bugs": {
		"url": "https://github.com/react-hookz/web/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/react-hookz/web.git"
	},
	"files": [
		"./dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json",
		"./*.js": "./dist/*.js",
		"./*": "./dist/*/index.js",
		"./*/": "./dist/*/index.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp run build:clean && tsc --version && tsc --project ./tsconfig.build.json",
		"build:clean": "rimraf ./dist",
		"fmt": "vp fmt --write",
		"fmt:check": "vp fmt --check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"test": "vp test --run",
		"test:coverage": "vp test --run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ver0/deep-equal": "^2.0.1"
	},
	"devDependencies": {
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@ver0/oxlint-config": "^2.0.2",
		"@ver0/react-hooks-testing": "^1.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"js-cookie": "^3.0.8",
		"jsdom": "^30.0.1",
		"oxlint": "^1.76.0",
		"oxlint-tsgolint": "^7.0.2001",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rimraf": "^6.1.3",
		"semantic-release": "^25.0.8",
		"typescript": "^7.0.2",
		"vite-plus": "^0.2.7",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"js-cookie": "^3.0.5",
		"react": "^16.8 || ^17 || ^18 || ^19",
		"react-dom": "^16.8 || ^17 || ^18 || ^19"
	},
	"peerDependenciesMeta": {
		"js-cookie": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "yarn@4.17.1"
}
